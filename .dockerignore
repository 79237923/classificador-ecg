.venv/
__pycache__/
*.pyc
.git/

# Dados locais — NUNCA vão para a imagem. O banco cifrado, a chave e a trilha
# de auditoria da máquina de desenvolvimento não devem viajar para o servidor.
data/
secrets/
*.key

