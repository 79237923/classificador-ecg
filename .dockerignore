data/ptbxl/
data/ptbxl_raw/
data/ptbxl.zip
data/ptbxl_cache.npz

# Pesos do PyTorch: o servidor usa apenas o .onnx
models/*.pt

# Scripts de desenvolvimento, treino e teste não vão para produção
scripts/
requirements-dev.txt
README.md
